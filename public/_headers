# Cloudflare Workers Static Assets — caching & security headers

# 1-Year Immutable Caching for Next.js Versioned Bundles
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 30-Day Caching for Photographic Plates & Assets
/photography/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/author-*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/og.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/icon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/apple-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# AI & LLM Machine Directives
/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# Global Security & Hardening Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
